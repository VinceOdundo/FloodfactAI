# FloodFact AI — environment configuration
#
# Every external provider below auto-detects live vs. sandbox mode by
# whether its variables are set — there is no manual switch. Leave a whole
# section blank and the app runs that piece in a clearly-labeled sandbox
# mode. See docs/SETUP.md for how to obtain each value (most are free).

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="FloodFact AI"

# ── Supabase (required for a real deployment) ───────────────────────────
# Leave all three blank to run the UI against static DEMO_MODE fixtures
# instead of a real database — useful for a quick local preview.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DEMO_MODE=false

# ── Security (required for a real deployment) ───────────────────────────
# Generate with: openssl rand -hex 32
CRON_SECRET=
REPORT_HMAC_SECRET=
ADMIN_REVEAL_AUDIT_SALT=
AT_INBOUND_SECRET=

# ── WhatsApp Cloud API (Meta) — optional, sandbox mode if absent ────────
# developers.facebook.com -> create an app -> add "WhatsApp" product.
# The free test number lets you message up to 5 verified recipients with
# no business verification — plenty for a hackathon demo.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ── SMS (Africa's Talking) — optional, sandbox mode if absent ───────────
# africastalking.com -> sign up -> the "sandbox" app is instant and free.
AT_USERNAME=sandbox
AT_API_KEY=
AT_SHORTCODE=

# ── LLM (Anthropic Claude) — optional, sandbox mode if absent ───────────
# console.anthropic.com -> API keys. Used only for structured message
# understanding and rationale generation — never for the safety decision
# itself (see lib/core/risk-engine.ts).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Embeddings (Voyage AI) — optional, sandbox mode if absent ───────────
# dash.voyageai.com -> API keys. Powers rumor-pattern similarity search.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# ── Weather (Open-Meteo) — free, keyless, no signup needed ──────────────
OPEN_METEO_BASE_URL=https://api.open-meteo.com

# ── Flood-risk geography (Esri ArcGIS) — optional ───────────────────────
# Many ArcGIS Living Atlas layers are queryable anonymously. Add a free
# developer key at developers.arcgis.com for higher-detail layers.
ARCGIS_API_KEY=
ARCGIS_FLOOD_LAYER_URL=

# ── Observability — optional ─────────────────────────────────────────────
SENTRY_DSN=
